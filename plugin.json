{
    "id": "inlineKeyboard",
    "name": "Inline Keyboard",
    "description": "On-screen touch keyboard for DMS with fcitx5 candidates drawn in-keyboard. Input-method switching goes through busctl (systemd) over D-Bus.",
    "version": "0.2.0",
    "license": "GPL-3.0-only",
    "author": "LilFishyChan",
    "icon": "keyboard",
    "type": "composite",
    "capabilities": [
        "daemon",
        "ipc",
        "dankbar-widget"
    ],
    "components": {
        "daemon": "./InlineKeyboardDaemon.qml",
        "widget": "./InlineKeyboardWidget.qml"
    },
    "settings": "./InlineKeyboardSettings.qml",
    "requires_dms": ">=2.0.0",
    "dependencies": [
        "ydotool"
    ],
    "permissions": [
        "settings_read",
        "settings_write",
        "process"
    ],
    "startupCheck": "./StartupCheck.qml"
}
